# CareerCompass AI - Environment Configuration Example

# Backend Configuration (backend/.env)
PORT=5000
MONGODB_URI=mongodb://localhost:27017/careercompass
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional AI API Key (Backend only)
# If left blank, the built-in rule-based expert counselor and recommendation engine is used
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000/api
